{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "default_locale": "en",
  "version": "1.11.17",
  "description": "__MSG_extDescription__",
  "key": "",
  "permissions": ["downloads", "contextMenus", "cookies", "storage", "tabs", "alarms", "scripting"],
  "optional_permissions": ["webRequest"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [{ "matches": ["*://*.douyin.com/*"], "js": ["douyin-hook.js"], "run_at": "document_start", "world": "MAIN" }],
  "action": { "default_title": "__MSG_extName__", "default_popup": "popup.html", "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png" } },
  "icons": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
}
