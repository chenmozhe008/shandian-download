{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "闪电全能下载",
  "version": "0.2.20",
  "identifier": "com.shandian.windows",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null,
      "assetProtocol": { "enable": true, "scope": [] }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/256x256.png",
      "icons/icon.ico"
    ],
    "resources": {
      "resources/gopeed.exe": "gopeed.exe",
      "resources/WebView2Loader.dll": "WebView2Loader.dll",
      "resources/BrowserExtension": "BrowserExtension"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false,
        "languages": [
          "SimpChinese"
        ],
        "installerIcon": "icons/icon.ico",
        "headerImage": "icons/header.bmp",
        "sidebarImage": "icons/sidebar.bmp"
      }
    }
  }
}
