+		if finalErr == nil && f.meta.Res.Range {
+			for _, conn := range f.connections {
+				if conn.Chunk != nil && conn.Chunk.remain() > 0 {
+					if re := extractRequestError(conn.lastErr); re != nil {
+						finalErr = fmt.Errorf("connection %d failed: status=%d", conn.ID, re.Code)
+					} else {
+						finalErr = fmt.Errorf("connection %d incomplete: %d bytes left", conn.ID, conn.Chunk.remain())
+					}
+					break
+				}
+			}
+		}
 	}
 	f.connMu.Unlock()
 
diff --git a/internal/protocol/http/shandian_boost.go b/internal/protocol/http/shandian_boost.go
new file mode 100644
index 0000000..1e6888b
--- /dev/null
+++ b/internal/protocol/http/shandian_boost.go
@@ -0,0 +1,226 @@
+// 自适应加连接的部分逻辑参考并改写自 Ghost Downloader 的 http_pack/task.py。
+// 上游作者：XiaoYouChR 及项目贡献者；上游许可：GPL-3.0。
+// 本项目于 2026-11-13 改写适配 Gopeed；来源与改写范围见
+// docs/third-party-notices/ghost-downloader-reference.md。
+//
+package http
+
+import (
+	"context"
+	"math"
+	"time"
+
+	"github.com/GopeedLab/gopeed/internal/shandian"
+	"golang.org/x/time/rate"
+)
+
+// shandian: 两件事
+//  1. 失败退出的连接留下的范围交给别的连接接手（原版不接：服务器限并发时新连接被 403，那段就成了空洞）
+//  2. 自适应加连接：慢启动开满设定的连接数后，速度稳定了再加几个，加了明显变快就继续加，
+//     不划算就停（单连接限速的源，比如 GitHub Release、镜像站，多开连接才跑得满）
+
+var (
+	shandianBoostTick   = time.Second // 采样间隔（变量方便测试改小）
+	shandianBoostWindow = 5           // 速度看最近几次采样
+	shandianBoostStep   = 4           // 每次加几个
+	shandianBoostMax    = 16          // 最多加到几个（不超过设定值的 2 倍）
+)
+
+const (
+	shandianBoostStable = 0.15 // 每次采样偏离均值都在 15% 以内才算稳定
+	shandianBoostGain   = 0.8  // 速度提升比例至少是连接增加比例的 80% 才继续加
+)
+
+// 连接协程退出时调用（defer，先于 wg.Done）
+func (f *Fetcher) shandianMarkExited(conn *connection) {
+	f.connMu.Lock()
+	defer f.connMu.Unlock()
+	conn.exited = true
+	if conn.Completed || conn.ctx == nil || conn.ctx.Err() != nil || !f.meta.Res.Range ||
+		conn.Chunk == nil || conn.Chunk.remain() <= 0 {
+		return
+	}
+	conn.abandoned = true
+	// 被 403 拒：服务器限并发，不再加开连接
+	if re := extractRequestError(conn.lastErr); re != nil && re.Code == 403 {
+		f.shandianPauseExpansion()
+	}
+}
+
+func (f *Fetcher) shandianPauseExpansion() {
+	if f.slowStart == nil {
+		return
+	}
+	f.slowStart.mu.Lock()
+	f.slowStart.paused = true
+	f.slowStart.mu.Unlock()
+}
+
+// 调用方持有 connMu。把一个失败连接剩下的整段交给 helper
+func (f *Fetcher) shandianTakeAbandoned(helper *connection) bool {
+	for _, r := range f.connections {
+		if r == helper || !r.abandoned || r.Chunk == nil {
+			continue
+		}
+		r.abandoned = false
+		if r.Chunk.remain() <= 0 {
+			continue
+		}
+		begin := r.Chunk.Begin + r.Chunk.Downloaded
+		helper.Chunk.Begin = begin
+		helper.Chunk.End = r.Chunk.End
+		helper.Chunk.Downloaded = 0
+		r.Chunk.End = begin - 1
+		return true
+	}
+	return false
+}
+
+func (f *Fetcher) shandianBoostPaused() bool {
+	if f.slowStart == nil {
+		return true
+	}
+	f.slowStart.mu.Lock()
+	defer f.slowStart.mu.Unlock()
+	return f.slowStart.paused
+}
+
+// 已下字节数和还在跑的连接数
+func (f *Fetcher) shandianSnapshot() (total int64, live int) {
+	f.connMu.Lock()
+	defer f.connMu.Unlock()
+	if f.resolveConn != nil {
+		total += f.resolveConn.Downloaded
+	}
+	for _, c := range f.connections {
+		total += c.Downloaded
+		if !c.exited && !c.Completed && c.State != connFailed {
+			live++
+		}
+	}
+	return
+}
+
+// 从剩余最多的连接拆出后半段给新连接，每段仍不小于 shandianMinSplit。返回实际加了几个
+func (f *Fetcher) shandianAddConns(n int) int {
+	f.connMu.Lock()
+	running := false
+	for _, c := range f.connections {
+		if !c.exited {
+			running = true // 有连接没退出，wg 计数大于 0，此时 Add 是安全的
+			break
+		}
+	}
+	if !running || f.ctx == nil || f.ctx.Err() != nil {
+		f.connMu.Unlock()
+		return 0
+	}
+	var added []*connection
+	for i := 0; i < n; i++ {
+		var victim *connection
+		var most int64
+		for _, c := range f.connections {
+			if c.exited || c.Completed || c.abandoned || c.State == connFailed || c.Chunk == nil {
+				continue
+			}
+			if r := c.Chunk.remain(); r >= 2*shandianMinSplit && r > most {
+				victim, most = c, r
+			}
+		}
+		if victim == nil {
+			break
+		}
+		split := victim.Chunk.End - victim.Chunk.remain()/2
+		conn := &connection{
+			ID:    len(f.connections),
+			Role:  roleWorker,
+			State: connNotStarted,
+			Chunk: newChunk(split+1, victim.Chunk.End),
+		}
+		victim.Chunk.End = split
+		conn.ctx, conn.cancel = context.WithCancel(f.ctx)
+		f.connections = append(f.connections, conn)
+		f.wg.Add(1)
+		added = append(added, conn)
+	}
+	f.connMu.Unlock()
+	for _, c := range added {
+		go f.runConnection(c)
+	}
+	return len(added)
+}
+
+// 慢启动开满之后跑，直到暂停/下完/判定不划算
+func (f *Fetcher) shandianBoost(ctx context.Context) {
+	if !f.meta.Res.Range || f.meta.Res.Size <= 0 || f.slowStart == nil {
+		return
+	}
+	limit := min(f.slowStart.maxConnections*2, shandianBoostMax)
+	tick := time.NewTicker(shandianBoostTick)
+	defer tick.Stop()
+
+	var hist []float64
+	last := int64(-1)
+	checking := false
+	baseWorkers, baseSpeed := 0, 0.0
+	for {
+		select {
+		case <-ctx.Done():
+			return
+		case <-tick.C:
+		}
+		// 限流过、或者开了全局限速（多开连接也快不了），都不加
+		if f.shandianBoostPaused() || shandian.Limiter.Limit() != rate.Inf {
+			return
+		}
+		total, live := f.shandianSnapshot()
+		if live == 0 {
+			return
+		}
+		if last >= 0 {
+			hist = append(hist, float64(total-last))
+			if len(hist) > shandianBoostWindow {
+				hist = hist[1:]
+			}
+		}
+		last = total
+		if len(hist) < shandianBoostWindow {
+			continue
+		}
+		avg := 0.0
+		for _, s := range hist {
+			avg += s
+		}
+		avg /= float64(len(hist))
+		if avg <= 0 {
+			continue
+		}
+
+		if checking {
+			workerRatio := float64(live-baseWorkers) / float64(baseWorkers)
+			speedRatio := (avg - baseSpeed) / baseSpeed
+			if workerRatio <= 0 || speedRatio < shandianBoostGain*workerRatio {
+				return
+			}
+			checking = false
+			hist = hist[:0]
+			continue
+		}
+
+		dev := 0.0
+		for _, s := range hist {
+			dev = math.Max(dev, math.Abs(s-avg)/avg)
+		}
+		if dev > shandianBoostStable || live >= limit {
+			if live >= limit {
+				return
+			}
+			continue
+		}
+		if f.shandianAddConns(min(shandianBoostStep, limit-live)) == 0 {
+			return
+		}
+		baseWorkers, baseSpeed, checking = live, avg, true
+		hist = hist[:0]
+	}
+}
diff --git a/internal/protocol/http/shandian_multi.go b/internal/protocol/http/shandian_multi.go
new file mode 100644
index 0000000..71be1df
--- /dev/null
+++ b/internal/protocol/http/shandian_multi.go
@@ -0,0 +1,768 @@
+package http
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	nethttp "net/http"
+	"net/url"
+	"path"
+	"regexp"
+	"slices"
+	"strings"
+	"sync"
+	"time"
+
+	"github.com/GopeedLab/gopeed/internal/controller"
+	"github.com/GopeedLab/gopeed/internal/fetcher"
+	"github.com/GopeedLab/gopeed/pkg/base"
+	fhttp "github.com/GopeedLab/gopeed/pkg/protocol/http"
+	"github.com/GopeedLab/gopeed/pkg/util"
+)
+
+// shandian: 多文件 HTTP 任务。网盘文件夹是一个文件一条直链，这里把它们做成内核里的一条任务，
+// 像 BT 任务一样有一个文件夹和文件列表。每个文件由一个普通 HTTP Fetcher 下载。
+// 链接形如 shandian-multi:<文件夹名>，文件列表在 req.extra.files。
+
+const MultiScheme = "shandian-multi"
+
+var (
+	// 不用固定间隔：一个文件结束就立刻开下一个。同时下载数按服务器的反应调整：
+	// 从 8 个开始，每成功一个加 1，最多 16 个；失败一次减半，最少 2 个
+	shandianMultiStart = 8
+	shandianMultiMax   = 16
+	shandianMultiMin   = 2
+	// 网盘直链先过一道跳转（百度 d.pcs 实测每次约 2.7 秒，同时 3 个就开始断开），
+	// 跳转后的下载服务器同时 16 个也没事。所以只限制解析这一步，传输不受它影响
+	shandianMultiResolving = 2
+	shandianMultiRetry     = []time.Duration{2 * time.Second, 5 * time.Second, 15 * time.Second, 30 * time.Second, 60 * time.Second}
+)
+
+type MultiFile struct {
+	URL    string            `json:"url"`
+	Name   string            `json:"name"`
+	Header map[string]string `json:"header"`
+}
+
+type MultiReqExtra struct {
+	Files []*MultiFile `json:"files"`
+}
+
+// MultiFileStats 文件面板用的每个文件进度（GET /tasks/{id}/stats）
+type MultiFileStats struct {
+	Name       string `json:"name"`
+	Size       int64  `json:"size"`
+	Downloaded int64  `json:"downloaded"`
+	Status     string `json:"status"` // wait running done error
+	Error      string `json:"error,omitempty"`
+	// 排查慢的原因：这个文件花了多久（毫秒）、失败重试了几次、最后一次的错误
+	Millis int64 `json:"millis"`
+	// 分段：排队等解析名额、解析、传输（毫秒）
+	QueueMs    int64  `json:"queueMs"`
+	ResolveMs  int64  `json:"resolveMs"`
+	TransferMs int64  `json:"transferMs"`
+	Tries      int    `json:"tries"`
+	RetryLimit int    `json:"retryLimit"`
+	LastError  string `json:"lastError,omitempty"`
+}
+
+type MultiStats struct {
+	Files []*MultiFileStats `json:"files"`
+}
+
+type multiItem struct {
+	child      *Fetcher
+	busy       bool // 正在解析或下载，占一个名额
+	started    bool // 子任务已 Start，协程在等它结束；暂停后要由 Start 接着下
+	resolved   bool
+	done       bool
+	failed     bool // 自动重试用完了，等用户点继续
+	errText    string
+	tries      int
+	retryAt    time.Time
+	downloaded int64 // 已完成文件的字节数
+	restored   *fetcherData
+	skip       bool // 用户没选这个文件
+	startedAt  time.Time
+	millis     int64
+	queueMs    int64
+	resolveMs  int64
+	transferMs int64
+}
+
+type MultiFetcher struct {
+	ctl    *controller.Controller
+	meta   *fetcher.FetcherMeta
+	doneCh chan error
+
+	mu      sync.Mutex
+	items   []*multiItem
+	running bool
+	stopCh  chan struct{}
+	loopWg  sync.WaitGroup
+	wakeCh  chan struct{}
+	limit   int           // 当前允许同时下载的文件数
+	gate    chan struct{} // 同时解析的名额
+}
+
+func (m *MultiFetcher) Setup(ctl *controller.Controller) {
+	m.ctl = ctl
+	m.doneCh = make(chan error, 1)
+	m.wakeCh = make(chan struct{}, 1)
+	m.gate = make(chan struct{}, shandianMultiResolving)
+	if m.meta == nil {
+		m.meta = &fetcher.FetcherMeta{}
+	}
+}
+
+func (m *MultiFetcher) Resolve(req *base.Request, opts *base.Options) error {
+	if err := base.ParseReqExtra[MultiReqExtra](req); err != nil {
+		return err
+	}
+	extra, _ := req.Extra.(*MultiReqExtra)
+	if extra == nil || len(extra.Files) == 0 {
+		return errors.New("multi task has no files")
+	}
+	if opts == nil {
+		opts = &base.Options{}
+	}
+	name := strings.TrimPrefix(strings.TrimPrefix(req.URL, MultiScheme+":"), "//")
+	res := &base.Resource{Name: util.SafeFilename(name), Range: true}
+	m.items = nil
+	for _, f := range extra.Files {
+		sub, fname := multiSplitName(f.Name)
+		if fname == "" {
+			fname = (&FetcherManager{}).ParseName(f.URL)
+		}
+		res.Files = append(res.Files, &base.FileInfo{Name: fname, Path: sub, Req: multiChildReq(f, req)})
+		m.items = append(m.items, &multiItem{})
+	}
+	m.meta.Req = req
+	m.meta.Opts = opts
+	m.meta.Res = res
+	return nil
+}
+
+// 名字可以带子文件夹（a/b/c.mkv），保留网盘里的结构。每一段单独清理，.. 这类不能跳出任务文件夹
+func multiSplitName(name string) (sub, file string) {
+	var parts []string
+	for _, p := range strings.FieldsFunc(name, func(r rune) bool { return r == '/' || r == '\\' }) {
+		p = util.SafeFilename(strings.TrimSpace(p))
+		if p != "" && p != "." && p != ".." {
+			parts = append(parts, p)
+		}
+	}
+	if len(parts) == 0 {
+		return "", ""
+	}
+	return strings.Join(parts[:len(parts)-1], "/"), parts[len(parts)-1]
+}
+
+func multiChildReq(f *MultiFile, parent *base.Request) *base.Request {
+	r := &base.Request{URL: f.URL, Proxy: parent.Proxy, Labels: parent.Labels}
+	if len(f.Header) > 0 {
+		r.Extra = &fhttp.ReqExtra{Header: f.Header}
+	}
+	return r
+}
+
+func (m *MultiFetcher) childOpts(i int) *base.Options {
+	file := m.meta.Res.Files[i]
+	return &base.Options{Name: file.Name, Path: path.Join(m.meta.FolderPath(), file.Path)}
+}
+
+func (m *MultiFetcher) Start() error {
+	m.mu.Lock()
+	defer m.mu.Unlock()
+	if m.running {
+		return nil
+	}
+	m.padItems()
+	// 再次开始（继续、重试）：上一轮的结果作废，失败的文件重新有几次机会
+	select {
+	case <-m.doneCh:
+	default:
+	}
+	for _, it := range m.items {
+		if it.failed {
+			it.failed = false
+			it.tries = 0
+			it.errText = ""
+		}
+		it.retryAt = time.Time{}
+		// 暂停前已开始的文件：协程还在 Wait，这里接着下
+		if it.busy && it.started && it.child != nil && !it.skip {
+			if err := it.child.Start(); err != nil {
+				it.errText = err.Error()
+			}
+		}
+	}
+	m.limit = shandianMultiStart
+	m.running = true
+	m.stopCh = make(chan struct{})
+	m.loopWg.Add(1)
+	go m.loop(m.stopCh)
+	return nil
+}
+
+func (m *MultiFetcher) wake() {
+	select {
+	case m.wakeCh <- struct{}{}:
+	default:
+	}
+}
+
+func (m *MultiFetcher) loop(stop chan struct{}) {
+	defer m.loopWg.Done()
+	tick := time.NewTicker(50 * time.Millisecond)
+	defer tick.Stop()
+	for {
+		if m.schedule() {
+			return
+		}
+		select {
+		case <-stop:
+			return
+		case <-m.wakeCh:
+		case <-tick.C:
+		}
+	}
+}
+
+// 返回 true 表示这一轮结束了
+func (m *MultiFetcher) schedule() bool {
+	m.mu.Lock()
+	defer m.mu.Unlock()
+	if !m.running {
+		return true
+	}
+	busy, pending, ok, bad := 0, 0, 0, 0
+	for _, it := range m.items {
+		switch {
+		case it.skip:
+		case it.done:
+			ok++
+		case it.failed:
+			bad++
+		case it.busy:
+			busy++
+		default:
+			pending++
+		}
+	}
+	if busy == 0 && pending == 0 {
+		m.running = false
+		var err error
+		if bad > 0 {
+			err = fmt.Errorf("已完成 %d/%d，%d 个文件失败。点击继续重新获取地址并续传", ok, len(m.items), bad)
+		}
+		m.doneCh <- err
+		return true
+	}
+	now := time.Now()
+	for i, it := range m.items {
+		if busy >= m.limit {
+			break
+		}
+		if it.skip || it.done || it.failed || it.busy || now.Before(it.retryAt) {
+			continue
+		}
+		it.busy = true
+		if it.startedAt.IsZero() {
+			it.startedAt = now
+		}
+		busy++
+		go m.runItem(i, it)
+	}
+	return false
+}
+
+func (m *MultiFetcher) newChild(i int, it *multiItem) *Fetcher {
+	c := (&FetcherManager{}).Build().(*Fetcher)
+	file := m.meta.Res.Files[i]
+	if it.restored != nil {
+		c.connections = it.restored.Connections
+		c.redirectURL = it.restored.RedirectURL
+		// Setup 看到 Res 就当作已解析
+		c.meta = &fetcher.FetcherMeta{Req: file.Req, Opts: m.childOpts(i), Res: &base.Resource{
+			Range: len(it.restored.Connections) > 0 && it.restored.Connections[0].Chunk != nil,
+			Size:  file.Size,
+			Files: []*base.FileInfo{{Name: file.Name, Size: file.Size}},
+		}}
+		base.ParseReqExtra[fhttp.ReqExtra](c.meta.Req)
+		base.ParseOptExtra[fhttp.OptsExtra](c.meta.Opts)
+		if c.meta.Opts.Extra == nil {
+			c.meta.Opts.Extra = &fhttp.OptsExtra{}
+		}
+		if e := c.meta.Opts.Extra.(*fhttp.OptsExtra); e.Connections <= 0 {
+			e.Connections = len(it.restored.Connections)
+		}
+		it.resolved = true
+		it.restored = nil
+	}
+	c.Setup(m.ctl)
+	return c
+}
+
+func (m *MultiFetcher) runItem(i int, it *multiItem) {
+	m.mu.Lock()
+	c := it.child
+	if c == nil {
+		c = m.newChild(i, it)
+		it.child = c
+	}
+	needResolve := !it.resolved
+	m.mu.Unlock()
+
+	var err error
+	if needResolve {
+		req := *m.meta.Res.Files[i].Req
+		q := time.Now()
+		m.gate <- struct{}{}
+		r := time.Now()
+		if multiHasGate(req.URL) {
+			// 只有跳转这一步占名额，拿到下载服务器地址就放开
+			if loc := m.followGate(c, &req); loc != "" {
+				req.URL = loc
+			}
+			<-m.gate
+			err = c.Resolve(&req, m.childOpts(i))
+		} else {
+			err = c.Resolve(&req, m.childOpts(i))
+			<-m.gate
+		}
+		it.queueMs += r.Sub(q).Milliseconds()
+		it.resolveMs += time.Since(r).Milliseconds()
+		if err == nil {
+			m.mu.Lock()
+			it.resolved = true
+			if s := c.meta.Res.Size; s > 0 {
+				m.meta.Res.Files[i].Size = s
+				m.updateSize()
+			}
+			m.mu.Unlock()
+		}
+	}
+	if err == nil {
+		// Start 和是否在运行要在同一把锁里判断，否则会在 Pause 之后才开始
+		m.mu.Lock()
+		if !m.running {
+			// 解析期间用户暂停了：放掉连接，下次重新解析。这个 Fetcher 不能再 Start：
+			// Pause 删了预下载的临时文件，但计数还在，会把这段当成已下载，文件里留下空洞
+			it.busy = false
+			it.resolved = false
+			it.child = nil
+			m.mu.Unlock()
+			c.Pause()
+			return
+		}
+		err = c.Start()
+		it.started = err == nil
+		m.mu.Unlock()
+	}
+	if err == nil {
+		// Pause 不会让 Wait 返回，这个协程一直等到这个文件真的结束。
+		// 所以暂停期间 busy 保持为 true，继续时由 Start 接着下
+		x := time.Now()
+		err = c.Wait()
+		it.transferMs += time.Since(x).Milliseconds()
+	}
+	m.mu.Lock()
+	defer m.mu.Unlock()
+	it.busy = false
+	it.started = false
+	if err == nil {
+		it.done = true
+		it.millis = time.Since(it.startedAt).Milliseconds()
+		it.downloaded = c.meta.Res.Size
+		if it.downloaded <= 0 {
+			it.downloaded = c.Progress().TotalDownloaded()
+		}
+		m.meta.Res.Files[i].Size = it.downloaded
+		m.updateSize()
+		it.child = nil
+		m.limit = min(m.limit+1, shandianMultiMax)
+		m.wake()
+		return
+	}
+	it.errText = err.Error()
+	// 解析失败已经由名额管着；只有传输阶段失败才说明下载服务器受不了
+	if it.resolved {
+		m.limit = max(m.limit/2, shandianMultiMin)
+	}
+	if !it.resolved {
+		it.child = nil // 没解析成功的 Fetcher 不能复用
+	}
+	if multiRetryable(err) && it.tries < len(shandianMultiRetry) {
+		it.retryAt = time.Now().Add(shandianMultiRetry[it.tries])
+		it.tries++
+	} else {
+		it.failed = true
+	}
+	m.wake()
+}
+
+// 文件大小要等轮到它才知道。还不知道的按已知文件的平均大小估算，否则进度条会提前到 100%
+func (m *MultiFetcher) updateSize() {
+	var known, count, total int64
+	sel := m.meta.Opts.SelectFiles
+	for i, f := range m.meta.Res.Files {
+		if len(sel) > 0 && !slices.Contains(sel, i) {
+			continue
+		}
+		total++
+		if f.Size > 0 {
+			known += f.Size
+			count++
+		}
+	}
+	if count == 0 {
+		return
+	}
+	m.meta.Res.Size = known / count * total
+	if count == total {
+		m.meta.Res.Size = known
+	}
+}
+
+// 百度直链先到 d.pcs，它很慢且不耐并发，跳转后的 baidupcs.com 没有这个限制
+func multiHasGate(raw string) bool {
+	u, err := url.Parse(raw)
+	return err == nil && (u.Hostname() == "pcs.baidu.com" || strings.HasSuffix(u.Hostname(), ".pcs.baidu.com"))
+}
+
+// 只走跳转那一步，返回下载服务器地址。失败返回空，由 Resolve 按原链接再走一遍
+func (m *MultiFetcher) followGate(c *Fetcher, req *base.Request) string {
+	if err := base.ParseReqExtra[fhttp.ReqExtra](req); err != nil {
+		return ""
+	}
+	c.meta.Req = req
+	client := c.buildClient()
+	client.CheckRedirect = func(*nethttp.Request, []*nethttp.Request) error { return nethttp.ErrUseLastResponse }
+	for attempt := 0; attempt < 4; attempt++ {
+		if attempt > 0 {
+			time.Sleep(time.Duration(attempt) * time.Second)
+		}
+		r, err := c.buildRequest(context.TODO(), req)
+		if err != nil {
+			return ""
+		}
+		resp, err := client.Do(r)
+		if err != nil {
+			continue
+		}
+		resp.Body.Close()
+		if resp.StatusCode >= 300 && resp.StatusCode < 400 {
+			if loc, err := resp.Location(); err == nil {
+				return loc.String()
+			}
+		}
+		return ""
+	}
+	return ""
+}
+
+// 选中文件有变化。没选的不下、不算进总大小；已下的部分留着，再选上时接着下
+func (m *MultiFetcher) Patch(req *base.Request, opts *base.Options) error {
+	if req != nil && req.Extra != nil {
+		if err := m.refreshLinks(req); err != nil {
+			return err
+		}
+	}
+	if opts == nil || opts.SelectFiles == nil || m.meta.Res == nil {
+		return nil
+	}
+	m.mu.Lock()
+	m.padItems()
+	valid := make([]int, 0, len(opts.SelectFiles))
+	for _, i := range opts.SelectFiles {
+		if i >= 0 && i < len(m.items) {
+			valid = append(valid, i)
+		}
+	}
+	m.meta.Opts.SelectFiles = valid
+	var stop []*Fetcher
+	for i, it := range m.items {
+		want := slices.Contains(valid, i)
+		if !want && !it.skip {
+			it.skip = true
+			if it.busy && it.started && it.child != nil && m.running {
+				stop = append(stop, it.child)
+			}
+		} else if want && it.skip {
+			it.skip = false
+			if it.busy && it.started && it.child != nil && m.running {
+				if err := it.child.Start(); err != nil {
+					it.errText = err.Error()
+				}
+			}
+		}
+	}
+	m.updateSize()
+	m.mu.Unlock()
+	for _, c := range stop {
+		c.Pause()
+	}
+	m.wake()
+	return nil
+}
+
+// 只替换原文件地址，不重建 child 或 connections；因此已下载分段保持原样。
+func (m *MultiFetcher) refreshLinks(req *base.Request) error {
+	if err := base.ParseReqExtra[MultiReqExtra](req); err != nil {
+		return err
+	}
+	updates, ok := req.Extra.(*MultiReqExtra)
+	if !ok || len(updates.Files) == 0 {
+		return errors.New("没有新下载地址")
+	}
+	m.mu.Lock()
+	defer m.mu.Unlock()
+	if m.running {
+		return errors.New("请先暂停任务再更新下载地址")
+	}
+	if m.meta == nil || m.meta.Req == nil || m.meta.Res == nil {
+		return errors.New("原任务信息不完整")
+	}
+	current, ok := m.meta.Req.Extra.(*MultiReqExtra)
+	if !ok {
+		return errors.New("原文件信息不存在")
+	}
+	if len(current.Files) != len(m.meta.Res.Files) {
+		return errors.New("原文件信息不完整")
+	}
+	m.padItems()
+	indices := make(map[string]int)
+	for i, f := range current.Files {
+		if _, exists := indices[f.Name]; exists {
+			return errors.New("原文件名重复，不能安全匹配")
+		}
+		indices[f.Name] = i
+	}
+	seen := make(map[string]bool)
+	// 整批先验证，任何不匹配都不改动原任务。
+	for _, f := range updates.Files {
+		i, exists := indices[f.Name]
+		if !exists || seen[f.Name] {
+			return errors.New("新地址的文件名与原任务不匹配")
+		}
+		seen[f.Name] = true
+		old, _ := url.Parse(current.Files[i].URL)
+		fresh, err := url.Parse(f.URL)
+		if err != nil || old == nil || fresh.Host == "" || (fresh.Scheme != "http" && fresh.Scheme != "https") || old.EscapedPath() != fresh.EscapedPath() {
+			return errors.New("新旧地址不是同一资源，已保留原进度")
+		}
+	}
+	for _, f := range updates.Files {
+		i := indices[f.Name]
+		it := m.items[i]
+		if it.done {
+			continue
+		}
+		replacement := multiChildReq(f, m.meta.Req)
+		if it.child != nil {
+			if err := it.child.Patch(replacement, nil); err != nil {
+				return err
+			}
+		}
+		if it.restored != nil {
+			it.restored.RedirectURL = ""
+		}
+		current.Files[i] = f
+		m.meta.Res.Files[i].Req = replacement
+		it.failed = false
+		it.tries = 0
+		it.retryAt = time.Time{}
+		it.errText = ""
+	}
+	return nil
+}
+
+func (m *MultiFetcher) padItems() {
+	for m.meta.Res != nil && len(m.items) < len(m.meta.Res.Files) {
+		m.items = append(m.items, &multiItem{})
+	}
+	sel := m.meta.Opts.SelectFiles
+	for i, it := range m.items {
+		it.skip = len(sel) > 0 && !slices.Contains(sel, i)
+	}
+}
+
+func (m *MultiFetcher) Pause() error {
+	m.mu.Lock()
+	if m.running {
+		m.running = false
+		close(m.stopCh)
+	}
+	children := make([]*Fetcher, 0)
+	for _, it := range m.items {
+		if it.busy && it.started && it.child != nil && !it.skip {
+			children = append(children, it.child)
+		}
+	}
+	m.mu.Unlock()
+	m.loopWg.Wait()
+	var wg sync.WaitGroup
+	for _, c := range children {
+		wg.Add(1)
+		go func(c *Fetcher) {
+			defer wg.Done()
+			c.Pause()
+		}(c)
+	}
+	wg.Wait()
+	return nil
+}
+
+func (m *MultiFetcher) Close() error { return m.Pause() }
+
+func (m *MultiFetcher) Meta() *fetcher.FetcherMeta { return m.meta }
+
+func (m *MultiFetcher) itemDownloaded(it *multiItem) int64 {
+	if it.done {
+		return it.downloaded
+	}
+	if it.child != nil {
+		return it.child.Progress().TotalDownloaded()
+	}
+	if it.restored != nil {
+		var n int64
+		for _, c := range it.restored.Connections {
+			n += c.Downloaded
+		}
+		return n
+	}
+	return 0
+}
+
+func (m *MultiFetcher) Stats() any {
+	m.mu.Lock()
+	defer m.mu.Unlock()
+	out := &MultiStats{}
+	if m.meta.Res == nil {
+		return out
+	}
+	for i, it := range m.items {
+		s := &MultiFileStats{Name: path.Join(m.meta.Res.Files[i].Path, m.meta.Res.Files[i].Name), Size: m.meta.Res.Files[i].Size, Downloaded: m.itemDownloaded(it), Status: "wait", Millis: it.millis, QueueMs: it.queueMs, ResolveMs: it.resolveMs, TransferMs: it.transferMs, Tries: it.tries, RetryLimit: len(shandianMultiRetry), LastError: multiSafeError(it.errText)}
+		switch {
+		case it.done:
+			s.Status = "done"
+		case it.failed:
+			s.Status = "error"
+			s.Error = multiSafeError(it.errText)
+		case it.busy && m.running:
+			s.Status = "running"
+		case m.running && !it.skip && !it.retryAt.IsZero():
+			s.Status = "retrying"
+		}
+		out.Files = append(out.Files, s)
+	}
+	return out
+}
+
+// 报错里常带完整链接和令牌，不往外给
+var multiErrorURL = regexp.MustCompile(`https?://[^\s"'<>]+`)
+
+func multiSafeError(s string) string {
+	return multiErrorURL.ReplaceAllString(s, "<下载地址>")
+}
+
+var multiTerminalStatus = regexp.MustCompile(`(?:status=|code:\s*)(400|401|403|404|410)\b`)
+
+func multiRetryable(err error) bool {
+	if err != nil && multiTerminalStatus.MatchString(err.Error()) {
+		return false
+	}
+	if e := extractRequestError(err); e != nil {
+		switch e.Code {
+		case 400, 401, 403, 404, 410:
+			return false
+		}
+	}
+	return true
+}
+
+func (m *MultiFetcher) Progress() fetcher.Progress {
+	m.mu.Lock()
+	defer m.mu.Unlock()
+	p := make(fetcher.Progress, 0, len(m.items))
+	for _, it := range m.items {
+		if !it.skip {
+			p = append(p, m.itemDownloaded(it))
+		}
+	}
+	return p
+}
+
+func (m *MultiFetcher) Wait() error { return <-m.doneCh }
+
+// ---------- 管理器 ----------
+
+type multiItemData struct {
+	Done       bool
+	Resolved   bool
+	Downloaded int64
+	Millis     int64
+	Tries      int
+	LastError  string
+	Data       *fetcherData
+}
+
+type multiData struct {
+	Items []*multiItemData
+}
+
+type MultiFetcherManager struct{ FetcherManager }
+
+// Name 与 http 相同：配置（连接数、UA）共用一份，子任务要用
+func (fm *MultiFetcherManager) Name() string { return "http" }
+
+func (fm *MultiFetcherManager) Filters() []*fetcher.SchemeFilter {
+	return []*fetcher.SchemeFilter{{Type: fetcher.FilterTypeUrl, Pattern: MultiScheme}}
+}
+
+func (fm *MultiFetcherManager) Build() fetcher.Fetcher { return &MultiFetcher{} }
+
+func (fm *MultiFetcherManager) ParseName(u string) string {
+	return strings.TrimPrefix(strings.TrimPrefix(u, MultiScheme+":"), "//")
+}
+
+// AutoRename 关闭：重名由 App 在建任务前问用户
+func (fm *MultiFetcherManager) AutoRename() bool { return false }
+
+func (fm *MultiFetcherManager) Store(f fetcher.Fetcher) (any, error) {
+	m := f.(*MultiFetcher)
+	m.mu.Lock()
+	defer m.mu.Unlock()
+	out := &multiData{}
+	for _, it := range m.items {
+		d := &multiItemData{Done: it.done, Resolved: it.resolved, Downloaded: it.downloaded, Millis: it.millis, Tries: it.tries, LastError: multiSafeError(it.errText)}
+		if it.child != nil && it.resolved {
+			it.child.redirectLock.Lock()
+			d.Data = &fetcherData{Connections: it.child.connections, RedirectURL: it.child.redirectURL}
+			it.child.redirectLock.Unlock()
+		} else if it.restored != nil {
+			d.Data = it.restored
+		}
+		out.Items = append(out.Items, d)
+	}
+	return out, nil
+}
+
+func (fm *MultiFetcherManager) Restore() (any, func(meta *fetcher.FetcherMeta, v any) fetcher.Fetcher) {
+	return &multiData{}, func(meta *fetcher.FetcherMeta, v any) fetcher.Fetcher {
+		d := v.(*multiData)
+		m := &MultiFetcher{meta: meta}
+		base.ParseReqExtra[MultiReqExtra](meta.Req)
+		for _, x := range d.Items {
+			it := &multiItem{done: x.Done, downloaded: x.Downloaded, millis: x.Millis, tries: x.Tries, errText: x.LastError}
+			// 还没建立连接就暂停的，没有进度可接，重新解析
+			if !x.Done && x.Resolved && x.Data != nil && len(x.Data.Connections) > 0 {
+				it.restored = x.Data
+				it.resolved = false // newChild 恢复后置为 true
+			}
+			m.items = append(m.items, it)
+		}
+		return m
+	}
+}
