+)
+
+func multiFast(t *testing.T) {
+	r := shandianMultiRetry
+	shandianMultiRetry = []time.Duration{time.Millisecond, time.Millisecond}
+	t.Cleanup(func() { shandianMultiRetry = r })
+}
+
+func multiCtl() *controller.Controller {
+	ctl := controller.NewController()
+	ctl.GetConfig = func(v any) {
+		*(v.(**config)) = &config{Connections: 2}
+	}
+	return ctl
+}
+
+func multiStart(t *testing.T, dir string, files []*MultiFile) *MultiFetcher {
+	t.Helper()
+	m := (&MultiFetcherManager{}).Build().(*MultiFetcher)
+	m.Setup(multiCtl())
+	req := &base.Request{URL: MultiScheme + ":夹", Extra: &MultiReqExtra{Files: files}}
+	if err := m.Resolve(req, &base.Options{Path: dir}); err != nil {
+		t.Fatal(err)
+	}
+	if err := m.Start(); err != nil {
+		t.Fatal(err)
+	}
+	return m
+}
+
+func multiWait(t *testing.T, m *MultiFetcher) error {
+	t.Helper()
+	ch := make(chan error, 1)
+	go func() { ch <- m.Wait() }()
+	select {
+	case err := <-ch:
+		return err
+	case <-time.After(30 * time.Second):
+		t.Fatal("超时")
+		return nil
+	}
+}
+
+func multiBody(path string) []byte {
+	return bytes.Repeat([]byte(path[len(path)-1:]), 300*1024)
+}
+
+func multiServer(fail func(path string, hit int32) bool) *httptest.Server {
+	var hits [256]int32
+	return httptest.NewServer(nethttp.HandlerFunc(func(w nethttp.ResponseWriter, r *nethttp.Request) {
+		n := atomic.AddInt32(&hits[r.URL.Path[len(r.URL.Path)-1]], 1)
+		if fail != nil && fail(r.URL.Path, n) {
+			if conn, _, err := w.(nethttp.Hijacker).Hijack(); err == nil {
+				conn.Close()
+			}
+			return
+		}
+		nethttp.ServeContent(w, r, "x.bin", time.Time{}, bytes.NewReader(multiBody(r.URL.Path)))
+	}))
+}
+
+func multiFiles(url string, n int) []*MultiFile {
+	var out []*MultiFile
+	for i := 0; i < n; i++ {
+		out = append(out, &MultiFile{URL: fmt.Sprintf("%s/f%c", url, 'a'+i), Name: fmt.Sprintf("文件%c.bin", 'a'+i)})
+	}
+	return out
+}
+
+func multiCheck(t *testing.T, dir string, n int) {
+	t.Helper()
+	for i := 0; i < n; i++ {
+		c := byte('a' + i)
+		got, err := os.ReadFile(filepath.Join(dir, "夹", fmt.Sprintf("文件%c.bin", c)))
+		if err != nil || !bytes.Equal(got, multiBody(string(c))) {
+			t.Fatalf("文件 %c 内容不对，长度 %d: %v", c, len(got), err)
+		}
+	}
+}
+
+func TestShandianMulti_AllFilesInOneFolder(t *testing.T) {
+	multiFast(t)
+	srv := multiServer(nil)
+	defer srv.Close()
+	dir := t.TempDir()
+	m := multiStart(t, dir, multiFiles(srv.URL, 7))
+	if err := multiWait(t, m); err != nil {
+		t.Fatal(err)
+	}
+	multiCheck(t, dir, 7)
+	if want := int64(7 * 300 * 1024); m.Meta().Res.Size != want || m.Progress().TotalDownloaded() != want {
+		t.Fatalf("大小 %d 进度 %d", m.Meta().Res.Size, m.Progress().TotalDownloaded())
+	}
+}
+
+// 某个文件前几次都断开：自动重试后整个任务成功
+func TestShandianMulti_RetriesFailedFile(t *testing.T) {
+	multiFast(t)
+	old := shandianResolveRetry
+	shandianResolveRetry = []time.Duration{time.Millisecond}
+	defer func() { shandianResolveRetry = old }()
+	srv := multiServer(func(p string, hit int32) bool { return strings.HasSuffix(p, "b") && hit <= 3 })
+	defer srv.Close()
+	dir := t.TempDir()
+	m := multiStart(t, dir, multiFiles(srv.URL, 3))
+	if err := multiWait(t, m); err != nil {
+		t.Fatal(err)
+	}
+	multiCheck(t, dir, 3)
+}
+
+// 一个文件一直失败：其余下完，任务报错且不带链接；服务恢复后继续，只补失败的
+func TestShandianMulti_FailThenContinue(t *testing.T) {
+	multiFast(t)
+	old := shandianResolveRetry
+	shandianResolveRetry = []time.Duration{time.Millisecond}
+	defer func() { shandianResolveRetry = old }()
+	var broken atomic.Bool
+	broken.Store(true)
+	srv := multiServer(func(p string, hit int32) bool { return strings.HasSuffix(p, "b") && broken.Load() })
+	defer srv.Close()
+	dir := t.TempDir()
+	m := multiStart(t, dir, multiFiles(srv.URL, 3))
+	err := multiWait(t, m)
+	if err == nil || !strings.Contains(err.Error(), "已完成 2/3") {
+		t.Fatalf("err = %v", err)
+	}
+	st := m.Stats().(*MultiStats).Files[1]
+	if st.Status != "error" || strings.Contains(st.Error, "127.0.0.1") {
+		t.Fatalf("文件状态 %+v", st)
+	}
+	broken.Store(false)
+	if err := m.Start(); err != nil {
+		t.Fatal(err)
+	}
+	if err := multiWait(t, m); err != nil {
+		t.Fatal(err)
+	}
+	multiCheck(t, dir, 3)
+}
+
+// 暂停后继续：同一个进程内要下完且内容正确
+func TestShandianMulti_PauseResume(t *testing.T) {
+	multiFast(t)
+	srv := multiServer(nil)
+	defer srv.Close()
+	dir := t.TempDir()
+	m := multiStart(t, dir, multiFiles(srv.URL, 5))
+	time.Sleep(20 * time.Millisecond)
+	if err := m.Pause(); err != nil {
+		t.Fatal(err)
+	}
+	if err := m.Start(); err != nil {
+		t.Fatal(err)
+	}
+	if err := multiWait(t, m); err != nil {
+		t.Fatal(err)
+	}
+	multiCheck(t, dir, 5)
+}
+
+// 暂停、存盘（JSON 往返）、恢复（相当于重启内核）：要下完且内容正确
+func TestShandianMulti_Restore(t *testing.T) {
+	multiFast(t)
+	srv := multiServer(nil)
+	defer srv.Close()
+	dir := t.TempDir()
+	m := multiStart(t, dir, multiFiles(srv.URL, 5))
+	time.Sleep(20 * time.Millisecond)
+	if err := m.Pause(); err != nil {
+		t.Fatal(err)
+	}
+	fm := &MultiFetcherManager{}
+	data, err := fm.Store(m)
+	if err != nil {
+		t.Fatal(err)
+	}
+	raw, err := json.Marshal(data)
+	if err != nil {
