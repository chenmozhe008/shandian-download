--- /dev/null
+++ b/internal/protocol/bt/shandian_close_test.go
@@ -0,0 +1,22 @@
+package bt
+
+import (
+	"context"
+	"testing"
+)
+
+func TestShandianCloseWithoutActiveTorrent(t *testing.T) {
+	_, cancel := context.WithCancel(context.Background())
+	defer cancel()
+	for _, f := range []*Fetcher{
+		{},
+		{torrentDropFunc: cancel, uploadDoneCh: make(chan any, 1)},
+	} {
+		if err := f.Close(); err != nil {
+			t.Fatal(err)
+		}
+		if err := f.Close(); err != nil {
+			t.Fatal(err)
+		}
+	}
+}
