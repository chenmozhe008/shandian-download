index 0000000..ca78a72
--- /dev/null
+++ b/pkg/download/shandian_checkpoint_test.go
@@ -0,0 +1,38 @@
+package download
+
+import (
+	"github.com/GopeedLab/gopeed/internal/fetcher"
+	"github.com/GopeedLab/gopeed/pkg/base"
+	"testing"
+)
+
+func TestShandianMulti_CheckpointSurvivesRepeatedRestore(t *testing.T) {
+	storage := NewBoltStorage(t.TempDir())
+	defer storage.Close()
+	if err := storage.Setup([]string{bucketSave}); err != nil {
+		t.Fatal(err)
+	}
+	d := &Downloader{storage: storage}
+	task := &Task{ID: "original", Meta: &fetcher.FetcherMeta{Req: &base.Request{URL: "shandian-multi:folder"}}, Status: base.DownloadStatusPause, Progress: &Progress{Downloaded: 7}}
+	if err := storage.Put(bucketSave, task.ID, map[string]int{"retained": 7}); err != nil {
+		t.Fatal(err)
+	}
+	for i := 0; i < 3; i++ {
+		var data map[string]int
+		if err := d.loadFetcherState(task, &data); err != nil {
+			t.Fatal(err)
+		}
+		if data["retained"] != 7 {
+			t.Fatal("checkpoint consumed")
+		}
+	}
+	task.ID = "missing"
+	var data map[string]int
+	if err := d.loadFetcherState(task, &data); err == nil {
+		t.Fatal("missing segments must not restart from zero")
+	}
+	task.Status = base.DownloadStatusDone
+	if err := d.loadFetcherState(task, &data); err != nil {
+		t.Fatal(err)
+	}
+}
