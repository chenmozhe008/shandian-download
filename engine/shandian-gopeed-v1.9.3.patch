+package http
+
+import (
+	nethttp "net/http"
+	"net/http/httptest"
+	"net"
+	"net/http"
+	"strings"
+	"sync/atomic"
+	"testing"
+	"time"
+
+	"github.com/GopeedLab/gopeed/internal/test"
+	"github.com/GopeedLab/gopeed/pkg/base"
+)
+
+// 闪电下载补丁的测试
+
+// 新片厂 xpccdn：不带 Range 回 403，带 Range 才 206
+func TestShandian_Range403(t *testing.T) {
+	fs := test.StartTestFileServer() // 生成测试文件；Close 时会删掉它
+	defer fs.Close()
+	ln, _ := net.Listen("tcp", "127.0.0.1:0")
+	go http.Serve(ln, http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		if !strings.HasPrefix(r.Header.Get("Range"), "bytes=") {
+			w.WriteHeader(403)
+			return
+		}
+		http.ServeFile(w, r, test.BuildFile)
+	}))
+	defer ln.Close()
+	downloadNormal(ln, 4, t)
+}
+
+// 下载中途服务器一直回 429：不能永远「下载中」，要在放弃时限后报错
+func TestShandian_Persistent429Fails(t *testing.T) {
+	old := shandianExemptGiveUp
+	shandianExemptGiveUp = 5 * time.Second
+	defer func() { shandianExemptGiveUp = old }()
+	fs := test.StartTestFileServer()
+	defer fs.Close()
+	var n atomic.Int32
+	ln, _ := net.Listen("tcp", "127.0.0.1:0")
+	go http.Serve(ln, http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		if n.Add(1) > 1 { // 只有解析那一下正常，之后一律 429
+			w.WriteHeader(429)
+			return
+		}
+		http.ServeFile(w, r, test.BuildFile)
+	}))
+	defer ln.Close()
+	f := downloadReady(ln, 4, t)
+	// 解析的响应体也会被用来下载，掐掉它模拟中途断开
+	f.(*Fetcher).resolveRespLock.Lock()
+	if f.(*Fetcher).resolveResp != nil {
+		f.(*Fetcher).resolveResp.Body.Close()
+	}
+	f.(*Fetcher).resolveRespLock.Unlock()
+	if err := f.Start(); err != nil {
+		t.Fatal(err)
+	}
+	done := make(chan error, 1)
+	go func() { done <- f.Wait() }()
+	select {
+	case err := <-done:
+		if err == nil {
+			t.Fatal("一直 429 却报告完成")
+		}
+	case <-time.After(60 * time.Second):
+		t.Fatal("一直 429 时任务卡住不报错")
+	}
+}
+
+// 偶尔 429（像维基限流，约一半请求被拒）：退避重试后应能下完
+func TestShandian_Intermittent429Completes(t *testing.T) {
+	fs := test.StartTestFileServer()
+	defer fs.Close()
+	var n atomic.Int32
+	ln, _ := net.Listen("tcp", "127.0.0.1:0")
+	go http.Serve(ln, http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		if n.Add(1)%2 == 0 {
+			w.WriteHeader(429)
+			return
+		}
+		http.ServeFile(w, r, test.BuildFile)
+	}))
+	defer ln.Close()
+	downloadNormal(ln, 8, t)
+}
+
+// 服务器前两次直接断开（客户端看到 EOF），第三次正常：解析要成功
+func TestShandianResolveRetriesOnEOF(t *testing.T) {
+	old := shandianResolveRetry
+	shandianResolveRetry = []time.Duration{time.Millisecond, time.Millisecond, time.Millisecond}
+	defer func() { shandianResolveRetry = old }()
+	var hits int32
+	srv := httptest.NewServer(nethttp.HandlerFunc(func(w nethttp.ResponseWriter, r *nethttp.Request) {
+		if atomic.AddInt32(&hits, 1) <= 2 {
+			conn, _, err := w.(nethttp.Hijacker).Hijack()
+			if err == nil {
+				conn.Close()
+			}
+			return
+		}
+		w.Header().Set("Content-Length", "2")
+		w.Write([]byte("ok"))
+	}))
+	defer srv.Close()
+	f := buildFetcher()
+	if err := f.Resolve(&base.Request{URL: srv.URL + "/a.bin"}, &base.Options{}); err != nil {
+		t.Fatalf("应当重试成功: %v", err)
+	}
+	if atomic.LoadInt32(&hits) < 3 {
+		t.Fatalf("请求次数 %d", hits)
+	}
+}
+
+// 服务器限并发（超过 2 个连接回 403，常见于网盘 / 镜像站）：被拒的分片要有人接手，
+// 不能留一段空洞却报告下载完成
+func TestShandian_ConnLimit403NoHole(t *testing.T) {
+	fs := test.StartTestFileServer()
+	defer fs.Close()
+	var active atomic.Int32
+	ln, _ := net.Listen("tcp", "127.0.0.1:0")
+	go http.Serve(ln, http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		if active.Add(1) > 2 {
+			active.Add(-1)
+			w.WriteHeader(403)
+			return
+		}
+		defer active.Add(-1)
+		http.ServeFile(w, r, test.BuildFile)
+	}))
+	defer ln.Close()
+	downloadNormal(ln, 8, t)
+}
+
+// 单连接限速的源（像 GitHub Release、镜像站）：开满设定的连接数后应自适应再加，并且文件完整
+func TestShandian_BoostAddsConnections(t *testing.T) {
+	oldTick := shandianBoostTick
+	shandianBoostTick = 100 * time.Millisecond
+	defer func() { shandianBoostTick = oldTick }()
+	fs := test.StartTestFileServer()
+	defer fs.Close()
+	var active, peak atomic.Int32
+	ln, _ := net.Listen("tcp", "127.0.0.1:0")
+	go http.Serve(ln, http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		n := active.Add(1)
+		defer active.Add(-1)
+		for {
+			p := peak.Load()
+			if n <= p || peak.CompareAndSwap(p, n) {
+				break
+			}
+		}
+		http.ServeFile(&throttledWriter{ResponseWriter: w, bps: 15 << 20}, r, test.BuildFile)
+	}))
+	defer ln.Close()
+	downloadNormal(ln, 2, t)
+	if peak.Load() <= 2 {
+		t.Fatalf("单连接限速时没有加连接，最多同时 %d 个", peak.Load())
+	}
+}
+
+type throttledWriter struct {
+	http.ResponseWriter
+	bps int
+}
+
+func (w *throttledWriter) Write(p []byte) (int, error) {
+	n, err := w.ResponseWriter.Write(p)
+	time.Sleep(time.Duration(n) * time.Second / time.Duration(w.bps))
+	return n, err
+}
