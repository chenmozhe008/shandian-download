+	}
+	metaRaw, _ := json.Marshal(&fetcher.FetcherMeta{Req: m.meta.Req, Res: m.meta.Res, Opts: m.meta.Opts})
+	var meta fetcher.FetcherMeta
+	if err := json.Unmarshal(metaRaw, &meta); err != nil {
+		t.Fatal(err)
+	}
+	v, restore := fm.Restore()
+	if err := json.Unmarshal(raw, v); err != nil {
+		t.Fatal(err)
+	}
+	r := restore(&meta, v).(*MultiFetcher)
+	r.Setup(multiCtl())
+	if err := r.Start(); err != nil {
+		t.Fatal(err)
+	}
+	if err := multiWait(t, r); err != nil {
+		t.Fatal(err)
+	}
