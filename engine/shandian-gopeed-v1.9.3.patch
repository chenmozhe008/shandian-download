+
+type resumeCutReader struct {
+	*bytes.Reader
+	left int
+}
+
+func (r *resumeCutReader) Read(p []byte) (int, error) {
+	if r.left <= 0 {
+		return 0, io.ErrUnexpectedEOF
+	}
+	if len(p) > r.left {
+		p = p[:r.left]
+	}
+	n, e := r.Reader.Read(p)
+	r.left -= n
+	return n, e
+}
+func TestShandianMulti_RefreshLinksKeepsPartialChunks(t *testing.T) {
+	multiFast(t)
+	old := shandianResolveRetry
+	shandianResolveRetry = []time.Duration{time.Millisecond}
+	defer func() { shandianResolveRetry = old }()
+	body := bytes.Repeat([]byte("resume-content"), 2*1024*1024)
+	var resumed atomic.Bool
+	var oldGets atomic.Int32
+	srv := httptest.NewServer(nethttp.HandlerFunc(func(w nethttp.ResponseWriter, r *nethttp.Request) {
+		w.Header().Set("Content-Type", "application/octet-stream")
+		if r.URL.Query().Get("token") == "new" {
+			var offset int64
+			fmt.Sscanf(r.Header.Get("Range"), "bytes=%d-", &offset)
+			if offset > 0 {
+				resumed.Store(true)
+			}
+			nethttp.ServeContent(w, r, "video.bin", time.Time{}, bytes.NewReader(body))
+			return
+		}
+		if r.Method == "GET" && oldGets.Add(1) > 3 {
+			w.WriteHeader(403)
+			return
+		}
+		nethttp.ServeContent(w, r, "video.bin", time.Time{}, &resumeCutReader{Reader: bytes.NewReader(body), left: 128 * 1024})
+	}))
+	defer srv.Close()
+	dir := t.TempDir()
+	oldURL := srv.URL + "/video?token=old"
+	m := multiStart(t, dir, []*MultiFile{{URL: oldURL, Name: "video.bin"}})
+	defer func() { m.Pause() }()
+	if err := multiWait(t, m); err == nil {
+		t.Fatal("expected expired transfer")
+	}
+	before := m.Stats().(*MultiStats).Files[0].Downloaded
+	if before <= 0 {
+		t.Fatal("test did not retain partial data")
+	}
+	// 模拟重启后的磁盘状态恢复，再更新 URL，必须仍保留每段位置。
+	fm := &MultiFetcherManager{}
+	saved, err := fm.Store(m)
+	if err != nil {
+		t.Fatal(err)
+	}
+	encoded, _ := json.Marshal(saved)
+	data, restore := fm.Restore()
+	if err = json.Unmarshal(encoded, data); err != nil {
+		t.Fatal(err)
+	}
+	restored := restore(m.Meta(), data).(*MultiFetcher)
+	restored.Setup(multiCtl())
+	m = restored
+	if err = m.Patch(&base.Request{Extra: &MultiReqExtra{Files: []*MultiFile{{URL: srv.URL + "/wrong", Name: "video.bin"}}}}, nil); err == nil {
+		t.Fatal("accepted different resource")
+	}
+	if got := m.Stats().(*MultiStats).Files[0].Downloaded; got != before {
+		t.Fatalf("progress changed before validation: %d != %d", got, before)
+	}
+	if err = m.Patch(&base.Request{Extra: &MultiReqExtra{Files: []*MultiFile{{URL: srv.URL + "/video?token=new", Name: "video.bin"}}}}, nil); err != nil {
+		t.Fatal(err)
+	}
+	if got := m.Stats().(*MultiStats).Files[0].Downloaded; got != before {
+		t.Fatalf("progress lost after patch: %d != %d", got, before)
+	}
+	if err = m.Start(); err != nil {
+		t.Fatal(err)
+	}
+	if err = multiWait(t, m); err != nil {
+		t.Fatal(err)
+	}
+	if !resumed.Load() {
+		t.Fatal("new address did not receive a resumed Range")
+	}
+	got, err := os.ReadFile(filepath.Join(dir, "夹", "video.bin"))
+	if err != nil || !bytes.Equal(got, body) {
+		t.Fatal("resumed file differs from original")
+	}
+}
