--- /dev/null
+++ b/pkg/download/shandian_resume_test.go
@@ -0,0 +1,65 @@
+package download
+
+import (
+	"encoding/json"
+	"github.com/GopeedLab/gopeed/pkg/base"
+	"net/http"
+	"net/http/httptest"
+	"testing"
+	"time"
+)
+
+func TestShandianMulti_FailedResumePublishesError(t *testing.T) {
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		if r.Method == "HEAD" {
+			w.Header().Set("Content-Length", "1048576")
+			w.Header().Set("Accept-Ranges", "bytes")
+			return
+		}
+		w.WriteHeader(http.StatusForbidden)
+	}))
+	defer server.Close()
+	d := NewDownloader(&DownloaderConfig{StorageDir: t.TempDir()})
+	if err := d.Setup(); err != nil {
+		t.Fatal(err)
+	}
+	defer d.Close()
+	extra := map[string]any{"files": []map[string]any{{"url": server.URL + "/video.mp4", "name": "video.mp4"}}}
+	// Ensure ReqExtra has the same JSON shape as the REST API.
+	raw, _ := json.Marshal(extra)
+	var data map[string]any
+	json.Unmarshal(raw, &data)
+	id, err := d.CreateDirect(&base.Request{URL: "shandian-multi:folder", Extra: data}, &base.Options{Path: t.TempDir()})
+	if err != nil {
+		t.Fatal(err)
+	}
+	for round := 0; round < 8; round++ {
+		deadline := time.Now().Add(5 * time.Second)
+		for d.GetTask(id).Status != base.DownloadStatusError && time.Now().Before(deadline) {
+			time.Sleep(time.Millisecond)
+		}
+		task := d.GetTask(id)
+		if task.Status != base.DownloadStatusError {
+			t.Fatalf("round %d stuck in %s", round, task.Status)
+		}
+		stats, err := d.Stats(id)
+		if err != nil {
+			t.Fatal(err)
+		}
+		blob, _ := json.Marshal(stats)
+		var view struct {
+			Files []struct {
+				Tries int `json:"tries"`
+			} `json:"files"`
+		}
+		json.Unmarshal(blob, &view)
+		if len(view.Files) != 1 || view.Files[0].Tries != 0 {
+			t.Fatalf("403 must not auto-retry: %s", blob)
+		}
+		if round < 7 {
+			if err := d.Continue(&TaskFilter{IDs: []string{id}}); err != nil {
+				t.Fatal(err)
+			}
+		}
+	}
+}
